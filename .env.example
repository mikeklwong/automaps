# Node 22+: node --env-file=.env server/index.mjs
PORT=4173
HOST=127.0.0.1
# Set these when putting the prototype behind your own HTTPS reverse proxy.
# PUBLIC_ORIGIN=https://automaps.example.com
# MAP_USER_AGENT=Automaps/0.1 (contact: YOUR_PUBLIC_PROJECT_URL)
# ROUTER_URL=https://your-osrm-server.example.com
# GEOCODER_URL=https://your-nominatim-server.example.com
# Optional Overpass-compatible endpoint. Unset = speed limit unknown, never guessed.
# OVERPASS_URL=https://your-overpass-server.example.com/api/interpreter
# Optional WebRTC ICE servers. Use a trusted provider and short-lived credentials in production.
# ICE_SERVERS=[{"urls":"stun:YOUR_STUN_HOST:3478"}]
